{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Expire only untagged images after 30 days; preserve all tagged releases and signatures",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 30
      },
      "action": {"type": "expire"}
    }
  ]
}
