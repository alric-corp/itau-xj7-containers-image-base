{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "automerge": false,
  "prConcurrentLimit": 4,
  "timezone": "America/Sao_Paulo",
  "schedule": [
    "before 6am on monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/(?:build-base-images|test-promotion)\\.yml$/",
        "/^scripts/pipeline/runtime/runtime_images\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>cgr\\.dev/chainguard/(?:apko|melange)|quay\\.io/skopeo/stable|rhysd/actionlint)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "currentValueTemplate": "latest"
    }
  ]
}
